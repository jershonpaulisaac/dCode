# ─────────────────────────────────────────────────────────────────────────────
# CodeLens AI — environment variables
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Required for any features that persist analysis results or user sessions.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service role key — only used on the server side (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── GitHub API ────────────────────────────────────────────────────────────────
# Personal access token (classic) or fine-grained PAT with read:contents scope.
# Without this token the GitHub ingestion endpoint uses the unauthenticated API
# (60 req/hr per IP). With it the limit rises to 5 000 req/hr.
GITHUB_TOKEN=<your-github-personal-access-token>

# ── IBM Bob / Watson (optional) ───────────────────────────────────────────────
# Set these if you connect CodeLens AI to a Watson or IBM Bob backend for
# AI-assisted analysis or chat features.
BOB_API_URL=https://<your-bob-instance>.ibm.com
BOB_API_KEY=<your-bob-api-key>
